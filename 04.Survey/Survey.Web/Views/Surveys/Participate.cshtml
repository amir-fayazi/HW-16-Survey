@using Survey.Domain.Dtos.Parcitipation


@model SurveyVotingDto


@{
	int questionNumber = 1;
}



<section class="container py-5" dir="ltr">
	<form method="post"
		  asp-controller="Surveys"
		  asp-action="SubmitVote">


		<div class="card bg-dark text-white border-secondary rounded-4 shadow-lg">

			<div class="card-body p-4 p-md-5">

				<!-- Survey Header -->
				<div class="mb-4 pb-3 border-bottom border-secondary">

					<input type="hidden" name="SurveyId" value="@Model.SurveyId" />
					<h2 class="fw-bold mb-3">
						@Model.SurveyTitle
					</h2>
				</div>

				<!-- Question 1 -->
				@for (int i = 0; i < Model.Questions.Count; i++)
				{
					var question = Model.Questions[i];

					<div class="border border-secondary rounded-3 p-4 mb-4">

						<h5 class="fw-semibold mb-4">
							Question @i+1 : @question.QuestionText
						</h5>
						<input type="hidden" name="Answers[@i].QuestionId" value="@question.Id" />

						<div class="d-flex flex-nowrap gap-4 overflow-auto pb-2">

							@foreach (var option in question.Options)
							{

								<div class="form-check form-check-inline flex-shrink-0">
									<input class="form-check-input"
										   type="radio"
										   name="Answers[@i].OptionId"
										   id="option-@option.Id"
										   value="@option.Id">
									<label class="form-check-label"
										   for="option-@option.Id">
										@option.OptionText
									</label>
								</div>
							}


						</div>
					</div>
				}
				<!-- Question 2 -->
				<button class="btn btn-primary" type="submit"> Submit </button>

			</div>
		</div>

		
	</form>

	
</section>



